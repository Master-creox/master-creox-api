# Copy to .env and fill in real values. NEVER commit .env.
APP_NAME=Master CreoX API
ENVIRONMENT=development
DATABASE_PATH=data/master_creox.db
# Bootstrap admin key for creating/revoking API keys (long random string):
MASTER_CREOX_ADMIN_KEY=change-me-to-a-long-random-value
# JWT signing secret for user login tokens (long random string):
JWT_SECRET=change-me-to-another-long-random-value
JWT_EXPIRE_MINUTES=1440
RATE_LIMIT_PER_MINUTE=100
